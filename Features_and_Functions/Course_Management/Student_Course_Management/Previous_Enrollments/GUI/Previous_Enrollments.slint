import { ScrollView } from "std-widgets.slint";
import { CourseInfo } from "../../../Attendance/Shared/GUI/Shared_Structs.slint";

export component Previous_Enrollments inherits Rectangle {
    in-out property <float> ui-scale: 1.0;

    in property <[CourseInfo]> passed_courses;
    in property <[CourseInfo]> failed_courses;
    in property <string> enrollment_name: "";
    in property <string> enrollment_id: "";
    in property <string> enrollment_gpa: "";
    background: white;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 20px * root.ui-scale;
            spacing: 20px * root.ui-scale;
            alignment: start;

            Text {
                text: "Previous Enrollments";
                font-size: 24px * root.ui-scale;
                font-weight: 700;
                color: black;
            }

            // --- PASSED COURSES SECTION ---
            if (passed_courses.length > 0) : VerticalLayout {
                spacing: 15px * root.ui-scale;
                Text { text: "Passed Courses"; font-size: 20px * root.ui-scale; font-weight: 700; color: #2e7d32; }

                for course in passed_courses: Rectangle {
                    background: #f4f6f9;
                    border-radius: 10px * root.ui-scale;

                    HorizontalLayout {
                        VerticalLayout {
                            padding: 15px * root.ui-scale;
                            spacing: 8px * root.ui-scale;
                            Text { text: course.course_code + " - " + course.course_name; color: black; font-size: 18px * root.ui-scale; font-weight: 700; }
                            Text { text: "Instructor: " + course.instructor_name; font-size: 16px * root.ui-scale; color: #555; }
                        }

                        // Passed Grade Box (Renamed ID)
                        passed_grade_rect := Rectangle {
                            property <bool> show_details: false;
                            width: (passed_grade_rect.show_details && course.has_final_grade) ? 220px * root.ui-scale : 160px * root.ui-scale;
                            height: (passed_grade_rect.show_details && course.has_final_grade) ? 200px * root.ui-scale : 80px * root.ui-scale;
                            animate height, width { duration: 300ms; easing: ease-in-out; }

                            background: #f1f8e9; // Light Green
                            border-radius: 8px * root.ui-scale;
                            border-width: 1px;
                            border-color: #66bb6a;
                            clip: true;

                            if (course.has_final_grade) : TouchArea {
                                width: 100%; height: 100%;
                                clicked => { passed_grade_rect.show_details = !passed_grade_rect.show_details; }
                            }

                            Rectangle {
                                width: 100%; height: 100%;
                                VerticalLayout {
                                    y: passed_grade_rect.show_details ? -80px * root.ui-scale : 10px * root.ui-scale;
                                    height: 60px * root.ui-scale;
                                    alignment: center;
                                    animate y { duration: 300ms; easing: ease-in-out; }
                                    Text { text: "Overall Grade"; horizontal-alignment: center; font-size: 14px * root.ui-scale; color: #2e7d32; }
                                    Text { text: "Passed"; horizontal-alignment: center; font-size: 16px * root.ui-scale; font-weight: 700; color: #1b5e20; }
                                }

                                if (course.has_final_grade) : VerticalLayout {
                                    y: passed_grade_rect.show_details ? 15px * root.ui-scale : 100px * root.ui-scale;
                                    height: 160px * root.ui-scale;
                                    alignment: start;
                                    spacing: 4px * root.ui-scale;
                                    animate y { duration: 300ms; easing: ease-in-out; }
                                    Text { text: "Detailed Grades"; horizontal-alignment: center; font-size: 14px * root.ui-scale; font-weight: 700; color: #2e7d32; }
                                    Text { text: course.detailed_grades; horizontal-alignment: center; font-size: 15px * root.ui-scale; color: #2e7d32; wrap: word-wrap; }
                                }
                            }

                            if (course.has_final_grade) : Text {
                                text: passed_grade_rect.show_details ? "Show Less ▲" : "Show More ▼";
                                font-size: 10px * root.ui-scale;
                                font-weight: 700;
                                color: #2e7d32;
                                x: parent.width - self.width - 8px * root.ui-scale;
                                y: parent.height - self.height - 8px * root.ui-scale;
                            }
                        }
                    }
                }
            }

            // --- FAILED COURSES SECTION ---
            if (failed_courses.length > 0) : VerticalLayout {
                spacing: 15px * root.ui-scale;
                Text { text: "Failed Courses"; font-size: 20px * root.ui-scale; font-weight: 700; color: #c62828; }

                for course in failed_courses: Rectangle {
                    background: #f4f6f9;
                    border-radius: 10px * root.ui-scale;

                    HorizontalLayout {
                        VerticalLayout {
                            padding: 15px * root.ui-scale;
                            spacing: 8px * root.ui-scale;
                            Text { text: course.course_code + " - " + course.course_name; color: black; font-size: 18px * root.ui-scale; font-weight: 700; }
                            Text { text: "Instructor: " + course.instructor_name; font-size: 16px * root.ui-scale; color: #555; }
                        }

                        // Failed Grade Box (Renamed ID)
                        failed_grade_rect := Rectangle {
                            property <bool> show_details: false;
                            width: (failed_grade_rect.show_details && course.has_final_grade) ? 220px * root.ui-scale : 160px * root.ui-scale;
                            height: (failed_grade_rect.show_details && course.has_final_grade) ? 200px * root.ui-scale : 80px * root.ui-scale;
                            animate height, width { duration: 300ms; easing: ease-in-out; }

                            background: #ffebee; // Light Red
                            border-radius: 8px * root.ui-scale;
                            border-width: 1px;
                            border-color: #ef5350;
                            clip: true;

                            if (course.has_final_grade) : TouchArea {
                                width: 100%; height: 100%;
                                clicked => { failed_grade_rect.show_details = !failed_grade_rect.show_details; }
                            }

                            Rectangle {
                                width: 100%; height: 100%;
                                VerticalLayout {
                                    y: failed_grade_rect.show_details ? -80px * root.ui-scale : 10px * root.ui-scale;
                                    height: 60px * root.ui-scale;
                                    alignment: center;
                                    animate y { duration: 300ms; easing: ease-in-out; }
                                    Text { text: "Overall Grade"; horizontal-alignment: center; font-size: 14px * root.ui-scale; color: #c62828; }
                                    Text { text: "Failed"; horizontal-alignment: center; font-size: 16px * root.ui-scale; font-weight: 700; color: #b71c1c; }
                                }

                                if (course.has_final_grade) : VerticalLayout {
                                    y: failed_grade_rect.show_details ? 15px * root.ui-scale : 100px * root.ui-scale;
                                    height: 160px * root.ui-scale;
                                    alignment: start;
                                    spacing: 4px * root.ui-scale;
                                    animate y { duration: 300ms; easing: ease-in-out; }
                                    Text { text: "Detailed Grades"; horizontal-alignment: center; font-size: 14px * root.ui-scale; font-weight: 700; color: #c62828; }
                                    Text { text: course.detailed_grades; horizontal-alignment: center; font-size: 15px * root.ui-scale; color: #c62828; wrap: word-wrap; }
                                }
                            }

                            if (course.has_final_grade) : Text {
                                text: failed_grade_rect.show_details ? "Show Less ▲" : "Show More ▼";
                                font-size: 10px * root.ui-scale;
                                font-weight: 700;
                                color: #c62828;
                                x: parent.width - self.width - 8px * root.ui-scale;
                                y: parent.height - self.height - 8px * root.ui-scale;
                            }
                        }
                    }
                }
            }
        }
    }
}