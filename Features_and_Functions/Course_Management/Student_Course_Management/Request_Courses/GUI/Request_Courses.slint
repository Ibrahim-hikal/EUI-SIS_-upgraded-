import { TabWidget, ScrollView } from "std-widgets.slint";
import { CourseInfo } from "../../../Attendance/Shared/GUI/Shared_Structs.slint";

export component Request_Courses inherits Rectangle {
    //==================== INPUT PROPERTIES ====================
    in property <float> ui-scale: assigned_scale;
    in property <float> assigned_scale: 1.0;

    //==================== IN-OUT PROPERTIES ====================
    in-out property <string> student_id;
    in-out property <string> student_name;
    in-out property <string> faculty;

    in-out property <[CourseInfo]> available_courses;
    in-out property <[CourseInfo]> requested_courses;

    in-out property <int> current_page: 0;
    in-out property <int> courses_per_page: 5;
    in-out property <int> max_requests: 5;
    in-out property <string> status_message: "";
    in-out property <bool> request_submitted: false;
    pure callback get_page_items(int, int, [CourseInfo]) -> [CourseInfo];
        get_page_items(page, size, total_list) => {
            return total_list;
        }

    //==================== OUTPUT PROPERTIES ====================
    out property <int> total_pages: Math.max(1, Math.ceil(available_courses.length / courses_per_page));
    out property <bool> can_request_more: requested_courses.length < max_requests;


    //==================== CALLBACKS ====================
    // Core Logic
        callback request_course(string);          // Triggers C++ find_course and register_course
        callback load_available_courses();        // Tells C++ to refresh the tree/model

        // UI Interactions
        callback remove_requested_course(string); // If you want to undo a selection
        callback submit_course_requests();        // Batch submit all choices
        callback clear_selections();              // Reset local UI state;


    //==================== SPECIFICATIONS ====================
    background: white;
    min-height: 600px;
    min-width: 1024px;

    // Main layout container fixing the negative offset and visibility issues
    VerticalLayout {
        padding: 30px * root.ui-scale;
        spacing: 20px * root.ui-scale;

        // --- HEADER SECTION ---
        VerticalLayout {
            spacing: 8px * root.ui-scale;
            Text {
                text: "Student ID: " + root.student_id;
                font-size: 22px * root.ui-scale; color: black;
            }
            Text {
                text: "Student Name: " + root.student_name;
                font-size: 22px * root.ui-scale; color: black;
            }
            Text {
                text: "Faculty: " + root.faculty;
                font-size: 22px * root.ui-scale; color: black;
            }
            Text {
                text: "Requests: " + root.requested_courses.length + "/" + root.max_requests;
                font-size: 18px * root.ui-scale;
                color: root.requested_courses.length >= root.max_requests ? #dc3545 : #28a745;
                font-weight: 600;
            }
        }

        // Status message area
        if root.status_message != "" : Text {
            text: root.status_message;
            font-size: 16px * root.ui-scale;
            color: root.request_submitted ? #28a745 : #dc3545;
            horizontal-alignment: center;
        }

        // --- TABLE HEADER ---
        Rectangle {
            height: 45px * root.ui-scale;
            background: #007bff;
            border-radius: 5px;

            HorizontalLayout {
                padding-left: 15px * root.ui-scale;
                padding-right: 15px * root.ui-scale;
                Text { text: "Course Code"; font-weight: 700; width: 140px * root.ui-scale; color: white; vertical-alignment: center; }
                Text { text: "Course Name"; font-weight: 700; width: 300px * root.ui-scale; color: white; vertical-alignment: center; }
                Text { text: "Actions (Req / Prior / Wait / Quick / Info)"; font-weight: 700; color: white; vertical-alignment: center; }
            }
        }

        // --- TABLE BODY (SCROLLABLE) ---

                // 1. DEBUG WARNING: If C++ sends 0 courses, this will show up.
                if root.available_courses.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "No courses loaded! Check if Offered_Courses.csv is in the build folder.";
                        color: red;
                        font-size: 18px * root.ui-scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 2. THE ACTUAL TABLE
                if root.available_courses.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px * root.ui-scale;
                        padding-bottom: 20px * root.ui-scale;

                        // Notice the [i] here! We need the index to know which page we are on.
                        for course[i] in root.available_courses : Rectangle {

                            // PAGINATION LOGIC: Hides courses that aren't on the current page
                            visible: i >= root.current_page * root.courses_per_page && i < (root.current_page + 1) * root.courses_per_page;
                            height: self.visible ? 65px * root.ui-scale : 0px;
                            clip: true;

                            background: #fcfcfc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #cccccc;

                            HorizontalLayout {
                                padding-left: 15px * root.ui-scale;
                                padding-right: 15px * root.ui-scale;
                                spacing: 15px * root.ui-scale;

                                Text { text: course.course_code; vertical-alignment: center; width: 140px * root.ui-scale; color:black; }
                                Text { text: course.course_name; vertical-alignment: center; width: 300px * root.ui-scale; color :black; }

                                HorizontalLayout {
                                    spacing: 8px * root.ui-scale;
                                    alignment: center;
                                    horizontal-stretch: 1;

                                    Rectangle {
                                        width: 65px * root.ui-scale; height: 35px * root.ui-scale;
                                        background: req_touch.pressed ? #004a99 : (req_touch.has-hover ? #0056b3 : #007bff);
                                        animate background { duration: 150ms; }
                                        border-radius: 4px;
                                        Text { text: "Req"; color: white; font-size: 12px; font-weight: 600; }
                                        req_touch := TouchArea { clicked => { root.request_course(course.course_code); } }
                                                                    }

                                }
                            }
                        }
                    }
                }

        // --- FOOTER SECTION (PAGE INDICATOR) ---
        HorizontalLayout {
            padding: 10px * root.ui-scale;
            alignment: center;
            spacing: 30px * root.ui-scale;
            height: 60px * root.ui-scale;

            Rectangle {
                width: 100px * root.ui-scale; height: 40px * root.ui-scale;
                background: root.current_page > 0 ? #007bff : #6c757d;
                border-radius: 5px;
                Text { text: "Previous"; color: white; font-weight: 600; }
                TouchArea {
                    enabled: root.current_page > 0;
                    clicked => { root.current_page -= 1; }
                }
            }

            Text {
                text: "Page " + (root.current_page + 1) + " of " + root.total_pages;
                vertical-alignment: center;
                font-size: 18px * root.ui-scale;
                font-weight: 600;
                color: black;
            }

            Rectangle {
                width: 100px * root.ui-scale; height: 40px * root.ui-scale;
                background: root.current_page < root.total_pages - 1 ? #007bff : #6c757d;
                border-radius: 5px;
                Text { text: "Next"; color: white; font-weight: 600; }
                TouchArea {
                    enabled: root.current_page < root.total_pages - 1;
                    clicked => { root.current_page += 1; }
                }
            }
        }
    }
}