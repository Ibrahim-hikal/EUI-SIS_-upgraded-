            Text { text: root.c2_l_slot; x: 470px*root.ui-scale; y: 135px*root.ui-scale; font-size: 16px*root.ui-scale; font-weight: 600; color: root.course2_accept_button_pressed ? #00ff44 : root.course2_decline_button_pressed ? #ff0000 : black; }
            Text { text: root.c2_t_day; x: 620px*root.ui-scale; y: 135px*root.ui-scale; font-size: 16px*root.ui-scale; font-weight: 600; color: root.course2_accept_button_pressed ? #00ff44 : root.course2_decline_button_pressed ? #ff0000 : black; }
            Text { text: root.c2_t_slot; x: 750px*root.ui-scale; y: 135px*root.ui-scale; font-size: 16px*root.ui-scale; font-weight: 600; color: root.course2_accept_button_pressed ? #00ff44 : root.course2_decline_button_pressed ? #ff0000 : black; }
