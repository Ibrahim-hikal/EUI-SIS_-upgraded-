        Text { text: "Next Student";
               color: white;
               font-size: 27px * root.ui-scale;
             }
        Next_Student_Touch:= TouchArea {
            clicked => { root.next_student(); }
        }
    }

    Student_ID_Label:= Text {
        text: "Student ID: " + root.student_id;
