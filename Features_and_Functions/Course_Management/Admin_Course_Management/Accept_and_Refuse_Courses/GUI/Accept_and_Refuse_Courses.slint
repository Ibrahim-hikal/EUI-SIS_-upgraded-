import { TabWidget } from "std-widgets.slint";
export component Accept_and_Refuse_Courses inherits Rectangle {

    //properties
    in-out property <float> ui-scale: min(root.width / 1024px, root.height / 768px);
    in-out property <string> student_id;
    in-out property <string> student_name;
    in-out property <string> faculty;
    in-out property <bool> course1_accept_button_pressed: false;
    in-out property <bool> course2_accept_button_pressed: false;
    in-out property <bool> course3_accept_button_pressed: false;
    in-out property <bool> course4_accept_button_pressed: false;
    in-out property <bool> course5_accept_button_pressed: false;
    in-out property <bool> course1_decline_button_pressed: false;
    in-out property <bool> course2_decline_button_pressed: false;
    in-out property <bool> course3_decline_button_pressed: false;
    in-out property <bool> course4_decline_button_pressed: false;
    in-out property <bool> course5_decline_button_pressed: false;
    in-out property <string> c1_code; in-out property <string> c1_name; in-out property <string> c1_l_day; in-out property <string> c1_l_slot; in-out property <string> c1_t_day; in-out property <string> c1_t_slot;
    in-out property <string> c2_code; in-out property <string> c2_name; in-out property <string> c2_l_day; in-out property <string> c2_l_slot; in-out property <string> c2_t_day; in-out property <string> c2_t_slot;
    in-out property <string> c3_code; in-out property <string> c3_name; in-out property <string> c3_l_day; in-out property <string> c3_l_slot; in-out property <string> c3_t_day; in-out property <string> c3_t_slot;
    in-out property <string> c4_code; in-out property <string> c4_name; in-out property <string> c4_l_day; in-out property <string> c4_l_slot; in-out property <string> c4_t_day; in-out property <string> c4_t_slot;
    in-out property <string> c5_code; in-out property <string> c5_name; in-out property <string> c5_l_day; in-out property <string> c5_l_slot; in-out property <string> c5_t_day; in-out property <string> c5_t_slot;
    in-out property <bool> Submit_Button_Pressed: false;
    in-out property <bool> show_warning: false;

    callback submit_decisions();
    callback next_student();
    callback previous_student();

    focus_anchor := FocusScope { }
    min-height: 600px;
    min-width: 1024px;
    preferred-height: 768px;
    preferred-width: 1024px;
    max-height: 840px;
    max-width: 1300px;
    background: white;
Rectangle {
y:-50px*root.ui-scale;

    Warning_Message:= Text {
        text: "Please submit your decisions before proceeding!";
        color: red;
        font-size: 18px;
        font-weight: 700;
        x: (parent.width - self.width) / 2;
        y: 630px * root.ui-scale;
        visible: root.show_warning; // Only shows if true
    }
    Previous_Student_Button := Rectangle {
        width: Previous_Student_Touch.has-hover ? 210px * root.ui-scale :200px * root.ui-scale;
        height: Previous_Student_Touch.has-hover ? 65px * root.ui-scale :60px * root.ui-scale;
        x: (parent.width - self.width) / 3;
        y: 670px * (parent.height / 768px);
        background: Previous_Student_Touch.pressed? #003d80 : #007bff;
        border-radius: 15px * root.ui-scale;
        animate width, height, background { duration: 150ms; easing: ease-in; }

        Text { text: "Previous Student";
               color: white;
               font-size: 22px * root.ui-scale;
             }
        Previous_Student_Touch:= TouchArea {
            clicked => { root.previous_student(); }
        }
    }

    Next_Student_Button := Rectangle {
        width: Next_Student_Touch.has-hover ? 210px * root.ui-scale :200px * root.ui-scale;
        height: Next_Student_Touch.has-hover ? 65px * root.ui-scale :60px * root.ui-scale;
        x: (parent.width - self.width) / 1.5;
        y: 670px * (parent.height / 768px);
        background: Next_Student_Touch.pressed? #003d80 : #007bff;
        border-radius: 15px * root.ui-scale;
        animate width, height, background { duration: 150ms; easing: ease-in; }

        Text { text: "Next Student";
               color: white;
               font-size: 22px * root.ui-scale;
             }
        Next_Student_Touch:= TouchArea {
            clicked => {if (root.Submit_Button_Pressed) {
                                            root.show_warning = false; // Clear warning if allowed
                                            root.next_student();
                                        } else {
                                            root.show_warning = true; // Show warning if locked
                                        }
            }
        }
    }

    Student_ID_Label:= Text {
        text: root.student_id == "" ? "No Course Requests" : "Student ID: " + root.student_id;
        font-size: 24px * root.ui-scale;
        color: black;
        x: 30px * (parent.width / 1024px);
        y: 110px * (parent.height / 768px);
        font-weight: 550;
    }

    Student_Name_Label:= Text {
        text: "Student Name: " + root.student_name;
        font-size: 24px * root.ui-scale;
        color: black;
        x: 30px * (parent.width / 1024px);
        y: 150px * (parent.height / 768px);
        font-weight: 550;
    }

    Student_Faculty_Label:= Text {
