                       Accept_Btn5:= Image { visible: root.c5_code != "" && !(root.is_submitted && (root.course5_accept_button_pressed || root.course5_decline_button_pressed)); width: 40px*root.ui-scale; height: 40px*root.ui-scale; x: 880px*root.ui-scale; y: 300px*root.ui-scale; colorize: t5A.has-hover || root.course5_accept_button_pressed ? #00ff44 : #218838; source: @image-url("Accept-icon.svg"); t5A:=TouchArea { clicked => {root.course5_accept_button_pressed=true; root.course5_decline_button_pressed=false; root.Submit_Button_Pressed = false; root.is_submitted = false; root.Accept_button_clicked();} } }
                       Decline_Btn5:= Image { visible: root.c5_code != "" && !(root.is_submitted && (root.course5_accept_button_pressed || root.course5_decline_button_pressed)); width: 35px*root.ui-scale; height: 35px*root.ui-scale; x: 930px*root.ui-scale; y: 302px*root.ui-scale; colorize: t5D.has-hover || root.course5_decline_button_pressed ? #ff0000 : #ff7777; source: @image-url("Decline-icon.svg"); t5D:=TouchArea { clicked => {root.course5_decline_button_pressed=true; root.course5_accept_button_pressed=false; root.Submit_Button_Pressed = false; root.is_submitted = false; root.Refuse_button_clicked();} } }
                       Status_Text5:= Text { visible: root.c5_code != "" && root.is_submitted && (root.course5_accept_button_pressed || root.course5_decline_button_pressed); text: root.course5_accept_button_pressed ? "Accepted" : "Declined"; color: root.course5_accept_button_pressed ? #218838 : #ff0000; font-size: 18px * root.ui-scale; font-weight: 700; x: 880px * root.ui-scale; y: 312px * root.ui-scale; }
                   }
            }

            // --- NAVIGATION & SUBMIT SECTION ---
            Navigation_Container := Rectangle {
                width: 100%; height: 120px * root.ui-scale;
                y: 630px * root.ui-scale;

                Warning_Message := Text {
                    text: "Please submit your decisions before proceeding!";
                    color: red; font-size: 18px * root.ui-scale; font-weight: 700;
                    x: (parent.width - self.width) / 2; y: 0;
                    visible: root.show_warning;
                }

                HorizontalLayout {
                    y: 50px * root.ui-scale;
                    width: 900px * root.ui-scale; height: 65px * root.ui-scale;
                    x: (parent.width - self.width) / 2;
                    alignment: space-between;

                    // LEFT: Previous Button OR Blank Spacer
                    if(root.is_previous_student_available == true) : Previous_Student_Button := Rectangle {
                        width: Previous_Student_Touch.has-hover ? 210px * root.ui-scale : 200px * root.ui-scale;
                        background: Previous_Student_Touch.pressed? #003d80 : #007bff;
                        border-radius: 15px * root.ui-scale;
                        animate width, background { duration: 150ms; easing: ease-in; }
                        Text { text: "Previous Student"; color: white; font-size: 22px * root.ui-scale; }
                        Previous_Student_Touch:= TouchArea {
                            clicked => {
                                root.is_submitted = false; // Reset UI state
                                root.Submit_Button_Pressed = false;
                                root.previous_student();
                            }
                        }
                    }
                    if(root.is_previous_student_available == false) : Rectangle { width: 200px * root.ui-scale; }

                    // CENTER: Submit Button
                    Submit_Button := Rectangle {
                        width: Submit_Button_Touch.has-hover ? 210px * root.ui-scale : 200px * root.ui-scale;
                        background: Submit_Button_Touch.pressed? #00ff44 : #218838;
                        border-radius: 15px * root.ui-scale;
                        animate width, background { duration: 150ms; easing: ease-in; }
                        Text { text: "Submit"; color: black; font-size: 22px * root.ui-scale; }
                        Submit_Button_Touch:= TouchArea {
                            clicked => {
                                root.Submit_Button_Pressed = true;
                                root.show_warning = false;
                                root.is_submitted = true;
                                root.submit_decisions();
                            }
                        }
                    }

                    // RIGHT: Next Button OR Blank Spacer
                    if(root.is_next_student_available == true) : Next_Student_Button := Rectangle {
                        width: Next_Student_Touch.has-hover ? 210px * root.ui-scale : 200px * root.ui-scale;
                        background: Next_Student_Touch.pressed? #003d80 : #007bff;
                        border-radius: 15px * root.ui-scale;
                        animate width, background { duration: 150ms; easing: ease-in; }
                        Text { text: "Next Student"; color: white; font-size: 22px * root.ui-scale; }
                        Next_Student_Touch:= TouchArea {
                            clicked => {
                                if (root.Submit_Button_Pressed) {
                                    root.show_warning = false;
                                    root.is_submitted = false; // Reset UI state
                                    root.Submit_Button_Pressed = false;
                                    root.next_student();
                                } else {
                                    root.show_warning = true;
                                }
                            }
                        }
                    }
                    if(root.is_next_student_available == false) : Rectangle { width: 200px * root.ui-scale; }
                }
            }
        }

        // ==========================================
        // STATE 2: EMPTY STATE (No Requests)
        // ==========================================
        if (root.no_course_requests == true) : Rectangle {
            width: 100%;
            height: 100%;

            Text {
                text: "No Courses are being requested at the moment.";
                font-size: 32px * root.ui-scale;
                color: #555555;
                font-weight: 700;

                // Centers perfectly inside the window
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}