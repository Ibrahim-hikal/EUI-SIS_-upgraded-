        source: @image-url("Decline-icon.svg");
        Decline_touch4:=TouchArea {
            clicked => {course4_decline_button_pressed= true; course4_accept_button_pressed= false;}
        }
    }
    Decline_Button5:= Image{
        width: 35px * root.ui-scale;
        height: 35px * root.ui-scale;
        colorize: Decline_touch5.has-hover ? #ff0000 : #ff7777;
        x: Course_List_Table.x + Course_List_Table.width + 60px * root.ui-scale;
        y: Course_List_Table.y + Course_List_Table.height - 47px * root.ui-scale;
        source: @image-url("Decline-icon.svg");
        Decline_touch5:=TouchArea {
            clicked => {course5_decline_button_pressed= true; course5_accept_button_pressed= false;}
        }
    }
}
    Submit_Button := Rectangle {
        width: Submit_Button_Touch.has-hover ? 210px * root.ui-scale :200px * root.ui-scale;
        height: Submit_Button_Touch.has-hover ? 65px * root.ui-scale :60px * root.ui-scale;
        x: (parent.width - self.width) / 2;
        y: 700px * (parent.height / 768px);
        background: Submit_Button_Touch.pressed? #00ff44 : #218838;
        border-radius: 15px * root.ui-scale;
        animate width, height, background { duration: 150ms; easing: ease-in; }

        Text { text: "Submit";
               color: black;
               font-size: 22px * root.ui-scale;
             }
        Submit_Button_Touch:= TouchArea {
            clicked => {
                        Submit_Button_Pressed = true;
                        root.show_warning = false;
                        root.submit_decisions();
            }
        }
    }
}
