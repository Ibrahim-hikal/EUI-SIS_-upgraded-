            Text { text: root.c1_name; width: 220px*root.ui-scale; wrap:word-wrap; x: 120px*root.ui-scale; y: 75px*root.ui-scale; font-size: 16px*root.ui-scale; font-weight: 600; color: root.course1_accept_button_pressed ? #00ff44 : root.course1_decline_button_pressed ? #ff0000 : black; }
            Text { text: root.c1_l_day; x: 340px*root.ui-scale; y: 75px*root.ui-scale; font-size: 16px*root.ui-scale; font-weight: 600; color: root.course1_accept_button_pressed ? #00ff44 : root.course1_decline_button_pressed ? #ff0000 : black; }
            Text { text: root.c1_l_slot; x: 470px*root.ui-scale; y: 75px*root.ui-scale; font-size: 16px*root.ui-scale; font-weight: 600; color: root.course1_accept_button_pressed ? #00ff44 : root.course1_decline_button_pressed ? #ff0000 : black; }
