export struct StudentAttendanceData {
    id: string,
    name: string,
    present: bool,
}

export struct CourseInfo {
    course_code: string,
    course_name: string,
    instructor_name: string,
    credit_hours: string,
    lecture_slot: string,
    tutorial_slot: string,
    attendance_summary: string, // e.g., "Present: 4/5"
}