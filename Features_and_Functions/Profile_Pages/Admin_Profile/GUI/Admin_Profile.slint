import {Accept_and_Refuse_Courses} from "../../../Course_Management/Admin_Course_Management/Accept_and_Refuse_Courses/GUI/Accept_and_Refuse_Courses.slint";
export component Admin_Profile inherits Rectangle {


    //properties

    //...................Start Accept and refuse courses admin properties
        in-out property <string> student_id;
        in-out property <string> student_name;
        in-out property <string> faculty;
        in-out property <bool> course1_accept_button_pressed: false;
        in-out property <bool> course2_accept_button_pressed: false;
        in-out property <bool> course3_accept_button_pressed: false;
        in-out property <bool> course4_accept_button_pressed: false;
        in-out property <bool> course5_accept_button_pressed: false;
        in-out property <bool> course1_decline_button_pressed: false;
        in-out property <bool> course2_decline_button_pressed: false;
        in-out property <bool> course3_decline_button_pressed: false;
        in-out property <bool> course4_decline_button_pressed: false;
        in-out property <bool> course5_decline_button_pressed: false;
        in-out property <string> c1_code; in-out property <string> c1_name; in-out property <string> c1_l_day; in-out property <string> c1_l_slot; in-out property <string> c1_t_day; in-out property <string> c1_t_slot;
        in-out property <string> c2_code; in-out property <string> c2_name; in-out property <string> c2_l_day; in-out property <string> c2_l_slot; in-out property <string> c2_t_day; in-out property <string> c2_t_slot;
        in-out property <string> c3_code; in-out property <string> c3_name; in-out property <string> c3_l_day; in-out property <string> c3_l_slot; in-out property <string> c3_t_day; in-out property <string> c3_t_slot;
        in-out property <string> c4_code; in-out property <string> c4_name; in-out property <string> c4_l_day; in-out property <string> c4_l_slot; in-out property <string> c4_t_day; in-out property <string> c4_t_slot;
        in-out property <string> c5_code; in-out property <string> c5_name; in-out property <string> c5_l_day; in-out property <string> c5_l_slot; in-out property <string> c5_t_day; in-out property <string> c5_t_slot;
        in-out property <bool> Submit_Button_Pressed: false;
        in-out property <bool> show_warning: false;
        callback admin_next_student();
        callback admin_previous_student();
        callback admin_submit_decisions();
    //...................end of Accept and refuse courses admin properties

    in property <float> ui-scale: assigned_scale;
    property <int> selected-menu-item: 0; // 0: Profile, 1: Manage Courses, etc.

    in property <float> assigned_scale: 1.0;

    //in-out properties
    in-out property <int> Logout_value: 0; // 0: default, 1: confirmation, 2: finalized

    //callbacks
    callback Logout;


        min-height: 600px;
        min-width: 1024px;
        preferred-height: 768px;
        preferred-width: 1024px;
        max-height: 840px;
        max-width: 1300px;
        background: white;

        //Selection menu on the left side of the screen
        Selection_menu := Rectangle{
            width: 270px * root.ui-scale;
            x: 0;
            border-bottom-right-radius:15px;
            border-top-right-radius:15px;
            border-color: #727275;
            border-width: 2px;
            background: #d0d2d6;
            //Selection menu items
            //University logo
            University_logo := Image{
                source: @image-url("Uni-Logo.png");
                width: 200px * root.ui-scale;
                height: 75px * root.ui-scale;
                x: 30px * root.ui-scale;
                y: 20px * root.ui-scale;

            }
            //seperator line
            Seperator_line := Rectangle{
                width: 220px * root.ui-scale;
                height: 2px * root.ui-scale;
                x: 20px * root.ui-scale;
                y: 110px * root.ui-scale;
                background: #727275;
            }
            //Menu items
            //Profile button
            Profile_button := Rectangle{
                width: (selected-menu-item == 0 || Profile_Button_touch_area.has-hover)? 245px * root.ui-scale : 240px * root.ui-scale;
                height: (selected-menu-item == 0 || Profile_Button_touch_area.has-hover)? 63px * root.ui-scale : 60px * root.ui-scale;

                x: 10px * root.ui-scale;
                y: 150px * root.ui-scale;
                border-radius: 10px;
                background: Profile_Button_touch_area.pressed? #003d80:(selected-menu-item == 0 ? #007bff:#64647a);
                animate background,width,height{
                    duration: 200ms;
                    easing: ease-in-out;
                }


                Text{
                    text: "Profile";
                    font-size: 23px * root.ui-scale;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Profile_Button_touch_area := TouchArea{

                clicked => {
                    root.selected-menu-item = 0;
                }

                }
            }
            //Manage acadamic requests button
            Manage_ar_button := Rectangle{
                width: (selected-menu-item == 1 || Manage_ar_button_touch_area.has-hover)? 245px * root.ui-scale : 240px * root.ui-scale;
                height: (selected-menu-item == 1 || Manage_ar_button_touch_area.has-hover)? 63px * root.ui-scale : 60px * root.ui-scale;
                x: 10px * root.ui-scale;
                y: 250px * root.ui-scale;
                border-radius: 10px;
                background: Manage_ar_button_touch_area.pressed? #003d80:(selected-menu-item == 1 ? #007bff:#64647a);
                animate background,width,height{
                    duration: 200ms;
                    easing: ease-in-out;
                }


                Text{
                    text: " Acadamic requests";
                    font-size: 23px * root.ui-scale;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Manage_ar_button_touch_area := TouchArea{
                    clicked => {
                        root.selected-menu-item = 1;
                    }
                }
            }
            //Manage Members button
            Manage_members_button := Rectangle{
                width: (selected-menu-item == 2 || Manage_members_button_touch_area.has-hover)? 245px * root.ui-scale : 240px * root.ui-scale;
                height: (selected-menu-item == 2 || Manage_members_button_touch_area.has-hover)? 63px * root.ui-scale : 60px * root.ui-scale;
                x: 10px * root.ui-scale;
                y: 350px * root.ui-scale;
                border-radius: 10px;
                background: Manage_members_button_touch_area.pressed ?#003d80:(selected-menu-item == 2 ? #007bff:#64647a);
                animate background,width,height{
                    duration: 200ms;
                    easing: ease-in-out;
                }


                Text{
                    text: "Manage Members";
                    font-size: 23px * root.ui-scale;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Manage_members_button_touch_area := TouchArea{
                    clicked => {
                        root.selected-menu-item = 2;
                    }
                }
            }
            Requesting_courses_button := Rectangle{
                width: (selected-menu-item == 3 || Requesting_courses_button_touch_area.has-hover)? 245px * root.ui-scale : 240px * root.ui-scale;
                height: (selected-menu-item == 3 || Requesting_courses_button_touch_area.has-hover)? 63px * root.ui-scale : 60px * root.ui-scale;
                x: 10px * root.ui-scale;
                y: 450px * root.ui-scale;
                border-radius: 10px;
                background: Requesting_courses_button_touch_area.pressed ? #003d80:(selected-menu-item == 3 ? #007bff:#64647a);
                animate background,width,height{
                    duration: 200ms;
                    easing: ease-in-out;
                }


                Text{
                    text: "Course Requests";
                    font-size: 23px * root.ui-scale;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Requesting_courses_button_touch_area := TouchArea{
                    clicked => {
                        root.selected-menu-item = 3;
                    }
                }
            }
            Notifications_button := Rectangle{
                width: (selected-menu-item == 4 || Notifications_button_touch_area.has-hover)? 245px * root.ui-scale : 240px * root.ui-scale;
                height: (selected-menu-item == 4 || Notifications_button_touch_area.has-hover)? 63px * root.ui-scale : 60px * root.ui-scale;
                x: 10px * root.ui-scale;
                y: 550px * root.ui-scale;
                border-radius: 10px;
                background: Notifications_button_touch_area.pressed ? #003d80:(selected-menu-item == 4 ? #007bff:#64647a);
                animate background,width,height{
                    duration: 200ms;
                    easing: ease-in-out;
                }


                Text{
                    text: "Notifications";
                    font-size: 23px * root.ui-scale;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Notifications_button_touch_area := TouchArea{
                    clicked => {
                        root.selected-menu-item = 4;
                    }
                }
            }
            Logout_icon := Image{
                source: @image-url("exit.svg");
                width: 50px * root.ui-scale;
                height: 50px * root.ui-scale;
                x: 20px * root.ui-scale;
                y: 680px * root.ui-scale;
                colorize: Logout_touch_area.pressed ? #9c0c1b : (Logout_touch_area.has-hover ? #ff0000 : #000000);
                animate colorize{
                    duration: 200ms;
                    easing: ease-in-out;
                }

                Logout_touch_area := TouchArea{
                    width: 50px * root.ui-scale;
                    height: 50px * root.ui-scale;
                    clicked => {
                        root.Logout_value = 1; // Trigger logout confirmation
                    }
                }
            }
                if (root.Logout_value == 1) : Rectangle {
                    width: 400px * root.ui-scale;
                    height: 200px * root.ui-scale;
                    x: (root.width - self.width) / 2;
                    y: (root.height - self.height) / 2;
                    background: #d0d2d6;
                    border-radius: 15px;
                    border-color: #727275;
                    border-width: 2px;

                    Confirmation_text := Text {
                        text: "Are you sure you want to logout?";
                        font-size: 20px * root.ui-scale;
                        font-weight: 600;
                        color: #000000;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        y: 40px * root.ui-scale;
                    }
                    Yes_button := Rectangle {
                        width: 100px * root.ui-scale;
                        height: 40px * root.ui-scale;
                        x: 80px * root.ui-scale;
                        y: 120px * root.ui-scale;
                        border-radius: 10px;
                        background: Yes_button_touch_area.pressed ? darkred :(Yes_button_touch_area.has-hover ? red :#007bff);
                        animate background {
                            duration: 200ms;
                            easing: ease-in-out;
                        }

                        Text {
                            text: "Yes";
                            font-size: 18px * root.ui-scale;
                            font-weight: 600;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Yes_button_touch_area := TouchArea {
                            clicked => {
                                root.Logout_value = 2; // Finalize logout
                                root.Logout(); // Call the Logout callback
                            }
                        }
                    }
                    No_button := Rectangle {
                        width: 100px * root.ui-scale;
                        height: 40px * root.ui-scale;
                        x: 220px * root.ui-scale;
                        y: 120px * root.ui-scale;
                        border-radius: 10px;
                        background: No_button_touch_area.pressed ? #003d80 :(No_button_touch_area.has-hover ? #104682 :#007bff);
                        animate background {
                            duration: 200ms;
                            easing: ease-in-out;
                        }

                        Text {
                            text: "No";
                            font-size: 18px * root.ui-scale;
                            font-weight: 600;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        No_button_touch_area := TouchArea {
                            clicked => {
                                root.Logout_value = 0; // Cancel logout
                            }
                        }
                    }


                }
        }

        if (selected-menu-item == 3) : Accept_and_Refuse_Courses {
                    x: Selection_menu.width;
                    width: root.width - Selection_menu.width;
                    height: root.height;
                    ui-scale: root.ui-scale;

                    student_id <=> root.student_id;
                    student_name <=> root.student_name;
                    faculty <=> root.faculty;
                    Submit_Button_Pressed <=> root.Submit_Button_Pressed;
                    show_warning <=> root.show_warning;

                    course1_accept_button_pressed <=> root.course1_accept_button_pressed;
                    course2_accept_button_pressed <=> root.course2_accept_button_pressed;
                    course3_accept_button_pressed <=> root.course3_accept_button_pressed;
                    course4_accept_button_pressed <=> root.course4_accept_button_pressed;
                    course5_accept_button_pressed <=> root.course5_accept_button_pressed;
                    course1_decline_button_pressed <=> root.course1_decline_button_pressed;
                    course2_decline_button_pressed <=> root.course2_decline_button_pressed;
                    course3_decline_button_pressed <=> root.course3_decline_button_pressed;
                    course4_decline_button_pressed <=> root.course4_decline_button_pressed;
                    course5_decline_button_pressed <=> root.course5_decline_button_pressed;

                    c1_code <=> root.c1_code; c1_name <=> root.c1_name; c1_l_day <=> root.c1_l_day; c1_l_slot <=> root.c1_l_slot; c1_t_day <=> root.c1_t_day; c1_t_slot <=> root.c1_t_slot;
                    c2_code <=> root.c2_code; c2_name <=> root.c2_name; c2_l_day <=> root.c2_l_day; c2_l_slot <=> root.c2_l_slot; c2_t_day <=> root.c2_t_day; c2_t_slot <=> root.c2_t_slot;
                    c3_code <=> root.c3_code; c3_name <=> root.c3_name; c3_l_day <=> root.c3_l_day; c3_l_slot <=> root.c3_l_slot; c3_t_day <=> root.c3_t_day; c3_t_slot <=> root.c3_t_slot;
                    c4_code <=> root.c4_code; c4_name <=> root.c4_name; c4_l_day <=> root.c4_l_day; c4_l_slot <=> root.c4_l_slot; c4_t_day <=> root.c4_t_day; c4_t_slot <=> root.c4_t_slot;
                    c5_code <=> root.c5_code; c5_name <=> root.c5_name; c5_l_day <=> root.c5_l_day; c5_l_slot <=> root.c5_l_slot; c5_t_day <=> root.c5_t_day; c5_t_slot <=> root.c5_t_slot;

                    next_student => { root.admin_next_student(); }
                    previous_student => { root.admin_previous_student(); }
                    submit_decisions => { root.admin_submit_decisions(); }

        }
}
