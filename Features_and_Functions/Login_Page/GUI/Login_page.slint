/*
 * FILE: Login_page.slint
 * DESCRIPTION: Complete login screen GUI component for the university management system
 *
 * PURPOSE: Provides the visual interface for user authentication including:
 *          - Portal selection (Student/Teacher/Admin)
 *          - Credential input fields (ID/Email and Password)
 *          - Password visibility toggle
 *          - Error message display
 *          - Responsive design with scaling
 *
 * FEATURES:
 *   - Three portal tabs with visual feedback
 *   - Dynamic field labels (ID vs Email based on portal)
 *   - Password show/hide toggle with eye icon
 *   - Error state handling with red borders and messages
 *   - Smooth animations and hover effects
 *   - Responsive scaling for different window sizes
 *
 * INTERACTIONS:
 *   - Portal buttons: Clear input fields when clicked
 *   - Login button: Triggers backend authentication
 *   - Password toggle: Shows/hides password characters
 *   - Input fields: Clear error state when user starts typing
 *
 * LAYOUT STRUCTURE:
 *   1. University header banner
 *   2. Portal selection buttons (Student/Teacher/Admin)
 *   3. Credential input fields (ID/Email + Password)
 *   4. Login button
 *   5. Exit button and university logo
 */

// ==========================================
// LOGIN PAGE COMPONENT
// ==========================================
/*
 * COMPONENT: Login_Page
 * PURPOSE: Main login screen component that handles user authentication UI
 *
 * INHERITS: Rectangle (basic container with background and sizing)
 *
 * RESPONSIVE DESIGN:
 *   - ui-scale: Scales all elements based on window size
 *   - Min/max dimensions prevent UI from becoming unusable
 *   - Preferred size defines the ideal layout
 */
export component Login_Page inherits Rectangle {

    // ==========================================
    // RESPONSIVE DESIGN PROPERTIES
    // ==========================================
    // Controls how much screen elements shrink/grow when window resizes
    // 1.0 = normal size, 0.8 = 80% smaller, 1.2 = 20% larger
    in property <float> ui-scale: 1.0;

    // ==========================================
    // PORTAL SELECTION STATE
    // ==========================================
    // Tracks which portal tab is currently active (for visual feedback)
    property <bool> Student_pressed: false;
    property <bool> Teacher_pressed: false;
    property <bool> Admin_pressed: false;

    // ==========================================
    // PASSWORD VISIBILITY
    // ==========================================
    // Toggles whether password is shown as plain text or hidden as dots
    property <bool> show_password: false;

    // ==========================================
    // DATA BINDING PROPERTIES (Connected to Backend)
    // ==========================================
    // These variables connect directly to the C++ backend for data exchange

    // Current selected portal: 1=Student, 2=Teacher, 3=Admin
    in-out property <int> Selected_Login_Type: 1;

    // User input fields (bidirectional - GUI updates backend, backend can clear)
    in-out property <string> id_email_input;    // ID for students, Email for staff
    in-out property <string> password_input;    // Password field

    // ==========================================
    // ERROR HANDLING PROPERTIES
    // ==========================================
    // Backend controls these to show login failure messages
    in-out property <bool> Error_State: false;        // True when login failed
    in-out property <string> Error_Message: "";       // Specific error message

    // ==========================================
    // CALLBACKS (Events sent to Backend)
    // ==========================================
    // Trigger that tells C++ backend to check the entered credentials
    callback login_attempted(string, string, int);

    // ==========================================
    // WINDOW SIZING CONSTRAINTS
    // ==========================================
    // Prevent UI from becoming too small or too large
    min-height: 600px;      // Minimum usable height
    min-width: 1024px;      // Minimum usable width
    preferred-height: 768px; // Ideal height
    preferred-width: 1024px; // Ideal width
    max-height: 840px;      // Maximum height (prevent excessive stretching)
    max-width: 1300px;      // Maximum width
    background: white;      // Clean white background

    // ==========================================
    // 1. UNIVERSITY HEADER BANNER
    // ==========================================
    /*
     * Top banner displaying the university name and branding
     * Centered horizontally, positioned near the top of the screen
     * Provides visual identity and context for the login page
     */
    Rectangle {
        width: 670px * root.ui-scale;
        height: 65px * root.ui-scale;
        x: (parent.width - self.width) / 2;                    // Center horizontally
        y: 100px * (root.height / 768px);                      // Position from top (scales with height)
        background: #abaeb3;                                   // Gray background
        border-radius: 15px * root.ui-scale;                   // Rounded corners

        // Inner title container for better visual hierarchy
        Title := Rectangle {
            width: 640px * root.ui-scale;
            height: 55px * root.ui-scale;
            x: (parent.width - self.width) / 2;               // Center within outer rectangle
            y: (parent.height - self.height) / 2;             // Center vertically
            background: #d0d2d6;                               // Lighter gray background
            border-radius: 15px * root.ui-scale;               // Rounded corners

            // Main title text
            Text {
                text: "Egypt University of Informatics Login Platform";
                color: black;
                font-weight: 700;                              // Bold text
                font-size: 28px * root.ui-scale;               // Large, readable text
            }
        }
    }

    // ==========================================
    // 2. PORTAL SELECTION MENU
    // ==========================================
    /*
     * Three-button menu to select between Student, Teacher, or Admin portals
     * Clicking a button changes the active portal and clears input fields
     * Provides visual feedback with color changes and animations
     */
    Login_Type := Rectangle {
        width: 950px * root.ui-scale;
        height: 90px * root.ui_scale;
        x: (parent.width - self.width) / 2;                    // Center horizontally
        y: 200px * (root.height / 768px);                      // Position below header
        border-radius: 15px * root.ui_scale;                   // Rounded corners
        background: #d0d2d6;                                   // Light gray background

        // ==========================================
        // STUDENT PORTAL BUTTON
        // ==========================================
        Student_Button := Rectangle {
            // Dynamic sizing: larger when selected or hovered
            width: (Selected_Login_Type == 1 || Student_Touch.has-hover) ? 240px * root.ui-scale : 230px * root.ui-scale;
            height: (Selected_Login_Type == 1 || Student_Touch.has-hover) ? 65px * root.ui-scale : 60px * root.ui-scale;
            x: 60px * (parent.width / 1024px);                // Left position (scales with width)
            y: (parent.height - self.height) / 2;             // Center vertically
            // Dynamic color: darker when pressed, blue when selected, gray when inactive
            background: Student_Touch.pressed ? #003d80 : (Selected_Login_Type == 1 ? #007bff : #586273);
            border-radius: 15px * root.ui_scale;               // Rounded corners
            animate width, height, background { duration: 150ms; } // Smooth size/color transitions

            // Button label
            Text {
                text: "Student";
                color: white;
                font-size: 30px * root.ui_scale;
            }

            // Click handling
            Student_Touch := TouchArea {
                clicked => {
                    Selected_Login_Type = 1;                   // Set to Student portal
                    Student_pressed = true;                    // Update visual state
                    Teacher_pressed = false;                   // Clear other states
                    Admin_pressed = false;
                    user_text.text = "";                       // Clear input fields
                    pass_text.text = "";
                }
            }
        }

        // ==========================================
        // TEACHER PORTAL BUTTON
        // ==========================================
        Teacher_Button := Rectangle {
            // Dynamic sizing: larger when selected or hovered
            width: (Selected_Login_Type == 2 || Teacher_Touch.has-hover) ? 240px * root.ui_scale : 230px * root.ui_scale;
            height: (Selected_Login_Type == 2 || Teacher_Touch.has-hover) ? 65px * root.ui_scale : 60px * root.ui-scale;
            x: 400px * (parent.width / 1024px);               // Center position
            y: (parent.height - self.height) / 2;             // Center vertically
            // Dynamic color: darker when pressed, blue when selected, gray when inactive
            background: Teacher_Touch.pressed ? #003d80 : (Selected_Login_Type == 2 ? #007bff : #586273);
            border-radius: 15px * root.ui_scale;               // Rounded corners
            animate width, height, background { duration: 150ms; } // Smooth transitions

            // Button label
            Text {
                text: "Teacher";
                color: white;
                font-size: 30px * root.ui_scale;
            }

            // Click handling
            Teacher_Touch := TouchArea {
                clicked => {
                    Selected_Login_Type = 2;                   // Set to Teacher portal
                    Student_pressed = false;                   // Clear other states
                    Teacher_pressed = true;                    // Update visual state
                    Admin_pressed = false;
                    user_text.text = "";                       // Clear input fields
                    pass_text.text = "";
                }
            }
        }

        // ==========================================
        // ADMIN PORTAL BUTTON
        // ==========================================
        Admin_Button := Rectangle {
            // Dynamic sizing: larger when selected or hovered
            width: (Selected_Login_Type == 3 || Admin_Touch.has-hover) ? 240px * root.ui_scale : 230px * root.ui_scale;
            height: (Selected_Login_Type == 3 || Admin_Touch.has-hover) ? 65px * root.ui_scale : 60px * root.ui_scale;
            x: 730px * (parent.width / 1024px);               // Right position
            y: (parent.height - self.height) / 2;             // Center vertically
            // Dynamic color: darker when pressed, blue when selected, gray when inactive
            background: Admin_Touch.pressed ? #003d80 : (Selected_Login_Type == 3 ? #007bff : #586273);
            border-radius: 15px * root.ui_scale;               // Rounded corners
            animate width, height, background { duration: 150ms; } // Smooth transitions

            // Button label
            Text {
                text: "Admin";
                color: white;
                font-size: 30px * root.ui_scale;
            }

            // Click handling
            Admin_Touch := TouchArea {
                clicked => {
                    Selected_Login_Type = 3;                   // Set to Admin portal
                    Student_pressed = false;                   // Clear other states
                    Teacher_pressed = false;
                    Admin_pressed = true;                      // Update visual state
                    user_text.text = "";                       // Clear input fields
                    pass_text.text = "";
                }
            }
        }

        // Focus management for keyboard navigation
        focus_anchor := FocusScope { }
    }

    // ==========================================
    // 3. CREDENTIAL INPUT FIELDS
    // ==========================================
    /*
     * Main input area containing ID/Email and password fields
     * Features dynamic labels, error states, and password visibility toggle
     */
    Username_Input := Rectangle {
        width: 950px * root.ui-scale;
        height: 280px * root.ui-scale;
        x: (parent.width - self.width) / 2;                    // Center horizontally
        y: 320px * (parent.height / 768px);                    // Position below portal buttons
        background: #e9ebf0;                                   // Light gray background
        border-radius: 15px * root.ui_scale;                   // Rounded corners

        // ==========================================
        // IDENTIFICATION FIELD (ID or Email)
        // ==========================================
        ID_Email := Rectangle {
            width: 880px * root.ui_scale;
            height: 80px * root.ui_scale;
            x: (parent.width - self.width) / 2;               // Center horizontally
            y: 30px * root.ui_scale;                           // Top position
            background: #d0d2d6;                               // Medium gray background
            border-radius: 15px * root.ui_scale;               // Rounded corners

            // Dynamic label that changes based on selected portal
            Username_Label := Text {
                text: Selected_Login_Type == 1 ? "ID:" : "Email:"; // "ID:" for students, "Email:" for staff
                color: black;
                font-size: 30px * root.ui_scale;
                font-weight: 700;                              // Bold text
                x: 40px * root.ui_scale;                       // Left margin
                vertical-alignment: center;                    // Center vertically
                height: 100%;                                  // Full height
            }

            // Input field container with error state handling
            User_Input_Container := Rectangle {
                width: 640px * root.ui_scale;
                height: 60px * root.ui_scale;
                x: 210px * root.ui_scale;                      // Right of label
                y: (parent.height - self.height) / 2;          // Center vertically
                background: white;                             // White background
                border-radius: 10px * root.ui_scale;           // Rounded corners

                // Dynamic border: blue when focused, red when error
                border-width: user_text.has-focus ? 2px : 0px; // Show border only when focused
                border-color: root.Error_State ? red : #007bff; // Red for errors, blue for normal

                // Placeholder text shown when field is empty and not focused
                if (user_text.text == "" && !user_text.has-focus) : Text {
                    text: Selected_Login_Type == 1 ? "Enter your ID" : "Enter your Email";
                    color: #aaa;                               // Light gray placeholder color
                    x: 15px;                                   // Left padding
                    vertical-alignment: center;                // Center vertically
                    height: 100%;                              // Full height
                    font-size: 18px * root.ui-scale;           // Smaller than input text
                }

                // Actual text input field
                user_text := TextInput {
                    width: 100%;
                    height: 100%;
                    x: 15px;                                   // Left padding
                    vertical-alignment: center;                // Center text vertically
                    font-size: 22px * root.ui_scale;           // Large, readable text
                    color: black;                              // Black text

                    // Bidirectional binding to backend variable
                    text <=> id_email_input;

                    // Clear error state when user starts typing
                    edited => {
                        if (root.Error_State) {
                            root.Error_State = false;           // Clear error flag
                            root.Error_Message = "";            // Clear error message
                        }
                    }
                }
            }
        }

        // ==========================================
        // PASSWORD FIELD
        // ==========================================
        Password_Field := Rectangle {
            width: 880px * root.ui_scale;
            height: 80px * root.ui_scale;
            x: (parent.width - self.width) / 2;               // Center horizontally
            y: 170px * root.ui_scale;                          // Below ID field
            background: #d0d2d6;                               // Medium gray background
            border-radius: 15px * root.ui_scale;               // Rounded corners

            // Password label
            Text {
                text: "Password:";
                color: black;
                font-size: 30px * root.ui_scale;
                font-weight: 700;                              // Bold text
                x: 40px * root.ui_scale;                       // Left margin
                vertical-alignment: center;                    // Center vertically
                height: 100%;                                  // Full height
            }

            // Password input container
            Pass_Input_Container := Rectangle {
                width: 640px * root.ui_scale;
                height: 60px * root.ui_scale;
                x: 210px * root.ui_scale;                      // Right of label
                y: (parent.height - self.height) / 2;          // Center vertically
                background: white;                             // White background
                border-radius: 10px * root.ui_scale;           // Rounded corners
                border-width: pass_text.has-focus ? 2px : 0px; // Show border when focused
                border-color: root.Error_State ? red : #007bff; // Red for errors, blue for normal

                // Placeholder text for password field
                if (pass_text.text == "" && !pass_text.has-focus) : Text {
                    text: "Enter your Password";
                    font-size: 18px * root.ui_scale;           // Smaller placeholder text
                    color: #aaa;                               // Light gray
                    x: 15px;                                   // Left padding
                    vertical-alignment: center;                // Center vertically
                    height: 100%;                              // Full height
                }

                // Password text input field
                pass_text := TextInput {
                    width: 100%;
                    height: 100%;
                    x: 15px;                                   // Left padding
                    vertical-alignment: center;                // Center text vertically
                    font-size: 22px * root.ui_scale;           // Large, readable text
                    color: black;                              // Black text

                    // Dynamic input type: show text or hide as dots
                    input-type: root.show_password ? text : password;
                    // Bidirectional binding to backend variable
                    text <=> password_input;

                    // Clear error state when user starts typing
                    edited => {
                        if (root.Error_State) {
                            root.Error_State = false;           // Clear error flag
                            root.Error_Message = "";            // Clear error message
                        }
                    }
                }

                // ==========================================
                // PASSWORD VISIBILITY TOGGLE ICON
                // ==========================================
                Image {
                    x: parent.width - 65px;                    // Position near right edge
                    width: 25px * root.ui_scale;               // Small icon size
                    height: 25px * root.ui_scale;

                    // Dynamic icon: eye-open when visible, eye-closed when hidden
                    source: root.show_password ? @image-url("eye-show.svg") : @image-url("eye-hide.svg");

                    // Click handler to toggle password visibility
                    TouchArea {
                        clicked => {
                            root.show_password = !root.show_password; // Toggle visibility flag
                        }
                    }
                }

                // ==========================================
                // ERROR MESSAGE DISPLAY
                // ==========================================
                // Shows specific login failure reasons below password field
                Error_Message_Display := Text {
                    text: root.Error_State ? root.Error_Message : ""; // Show message only when error
                    color: red;                               // Red error text
                    font-size: 16px * root.ui_scale;         // Smaller error text
                    font-weight: 700;                        // Bold error text
                    x: 60px * root.ui_scale;                 // Indent from left
                    y: 75px * root.ui_scale;                 // Position below input field
                }
            }
        }
    }

    // ==========================================
    // 4. LOGIN BUTTON
    // ==========================================
    /*
     * Main action button that triggers authentication
     * Sends current input values to backend for verification
     * Features hover animations and visual feedback
     */
    Login_Button := Rectangle {
        // Dynamic sizing: larger when hovered
        width: Login_touch.has-hover ? 210px * root.ui_scale : 200px * root.ui_scale;
        height: Login_touch.has-hover ? 65px * root.ui_scale : 60px * root.ui_scale;
        x: (parent.width - self.width) / 2;                    // Center horizontally
        y: 620px * (parent.height / 768px);                    // Position near bottom
        // Dynamic color: darker when pressed, blue otherwise
        background: Login_touch.pressed ? #003d80 : #007bff;
        border-radius: 15px * root.ui_scale;                   // Rounded corners
        // Smooth animations for size and color changes
        animate width, height, background { duration: 150ms; easing: ease-in; }

        // Button label
        Text {
            text: "Login";
            color: white;                                     // White text on blue background
            font-size: 30px * root.ui_scale;                  // Large, readable text
        }

        // Click handler that triggers authentication
        Login_touch := TouchArea {
            clicked => {
                // Send current input values to backend for verification
                login_attempted(id_email_input, password_input, Selected_Login_Type);
            }
        }
    }

    // ==========================================
    // 5. HEADER ELEMENTS (Exit Button & Logo)
    // ==========================================
    /*
     * Top-right exit button and top-left university logo
     * Provide window controls and branding
     */

    // Exit button in top-right corner
    Exit_Button := Image {
        width: 30px * root.ui_scale;
        height: 30px * root.ui_scale;
        // Dynamic color: red when hovered, black otherwise
        colorize: Exit_touch.has-hover ? red : black;
        x: parent.width - self.width - 20px;                  // Top-right position
        y: 20px;                                              // Top margin
        source: @image-url("Exit-icon.svg");                  // Exit icon file

        // Click handler (currently empty - could close window or go back)
        Exit_touch := TouchArea {
            clicked => { }                                    // Placeholder for exit functionality
        }
    }

    // University logo in top-left corner
    University_Logo := Image {
        width: 200px * root.ui_scale;
        height: 60px * root.ui_scale;
        x: 20px;                                              // Left margin
        y: 20px;                                              // Top margin
        source: @image-url("Uni-Logo.png");                   // University logo file
    }
}