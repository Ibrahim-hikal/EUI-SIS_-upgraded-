/*
 * FILE: main.slint
 * DESCRIPTION: Main entry point for the university management system GUI
 * This file controls the visual layout, data binding, and user interaction routing
 * between the C++ backend and the Slint UI framework.
 */

// ==========================================
// IMPORT STATEMENTS - UI COMPONENTS
// ==========================================
// Bring in the visual designs from other folders so we can build the main interface
import { Login_Page } from "Login_Page/GUI/Login_page.slint";
import { Student_Profile } from "Profile_Pages/Student_Profile/GUI/Student_Profile.slint";
import { Teacher_Profile } from "Profile_Pages/Teacher_Profile/GUI/Teacher_Profile.slint";
import { Admin_Profile } from "Profile_Pages/Admin_Profile/GUI/Admin_Profile.slint";

// ==========================================
// IMPORT STATEMENTS - DATA STRUCTURES
// ==========================================
// Bring in the data structures used for schedules, grades, and requests
import { CourseInfo, StudentAttendanceData, StudentGradeData } from "Course_Management/Attendance/Shared/GUI/Shared_Structs.slint";
import { WithdrawalRequest } from "Academic_Requests/Course_Withdrawal/Admin_Course_Withdrawal/GUI/Admin_Course_Withdrawal.slint";
import { ExcuseRequest } from "Academic_Requests/Attendance_Excuses/Admin_Attendance_Excuses/GUI/Admin_Attendance_Excuses.slint";
import { CourseSlot } from "Schedule/Student_Schedule/GUI/Student_Schedule.slint";

// ==========================================
// EXPORT STATEMENTS
// ==========================================
// Share these data structures so the C++ backend can read and write to them
export { WithdrawalRequest, ExcuseRequest, CourseSlot, CourseInfo, StudentAttendanceData, StudentGradeData }

// ==========================================
// MAIN APPLICATION WINDOW COMPONENT
// ==========================================
export component Main_App inherits Window {
    // ==========================================
    // WINDOW CONFIGURATION
    // ==========================================
    // Main window title and logo - displayed in the window title bar
    title: "University Management System";
    icon: @image-url("../EUI-logo.png");

    // Window sizing limits. Use preferred sizes so the user can stretch or shrink the window freely.
    // Minimum dimensions ensure UI remains usable on smaller screens
    min-width: 800px;
    min-height: 600px;
    // Preferred dimensions define the default window size on launch
    preferred-width: 1024px;
    preferred-height: 768px;

    // ==========================================
    // RESPONSIVE DESIGN SCALING
    // ==========================================
    // This calculates a scale factor based on the window size so the text and boxes adapt smoothly
    // It compares the actual window dimensions to the preferred dimensions
    property <float> global_scale: min(self.width / 1024px, self.height / 768px);

    // ==========================================
    // SCREEN NAVIGATION
    // ==========================================
    // This variable tracks which screen is currently visible to the user
    // Possible values: 0=Login, 1=Student Dashboard, 2=Teacher Dashboard, 3=Admin Dashboard
    // The C++ backend updates this value when user logs in or switches roles
    in-out property <int> active_panel: 0;

    // ==========================================
    // Variables shared across all screens
    // ==========================================
    in-out property <bool> login_error_state: false;
    in-out property <string> login_error_msg: "";
    in-out property <string> user_name;
    in-out property <string> user_id;
    in-out property <string> user_Faculty;
    in-out property <string> student_gpa;
    in-out property <string> user_email;
    in-out property <image> user_profile_pic;
    in-out property <int> Logout_value: 0;

    // ==========================================
    // Variables for the Student Dashboard
    // ==========================================
    in-out property <[CourseInfo]> my_courses;
    in-out property <[CourseInfo]> available_courses;
    in-out property <[CourseInfo]> requested_courses;
    in-out property <bool> request_submitted: false;
    in-out property <string> status_message;
    in-out property <int> student_active_tab: 0;
    in-out property <[string]> my_course_codes;
    in-out property <[CourseSlot]> student_schedule_data;
    in-out property <[CourseInfo]> passed_courses;
    in-out property <[CourseInfo]> failed_courses;
    in property <string> enrollment_name: "";
    in property <string> enrollment_id: "";
    in property <string> enrollment_gpa: "";

    // ==========================================
    // Variables for the Teacher Dashboard
    // ==========================================
    in-out property <[string]> teacher_profile_display_list;
    in-out property <[StudentAttendanceData]> students_data;
    in-out property <[StudentGradeData]> grades_data;
    in-out property <[CourseSlot]> teacher_schedule_data;

    // ==========================================
    // Variables for the Admin Dashboard
    // ==========================================
    in-out property <int> admin_active_tab: 0;
    in-out property <string> admin_position;
    in-out property <[WithdrawalRequest]> pending_withdrawals;
    in-out property <[ExcuseRequest]> pending_excuses;

    // Variables to handle adding new users or assigning courses
    in property <string> assign_course_status_message: "";
    in property <string> add_student_status_message: "";
    in property <string> next_student_id: "Loading...";
    in property <string> add_teacher_status_message: "";

    // The massive block of variables below holds all the details for a student's course requests.
    // It passes the specific times, days, and course codes so the admin can review them.
    in-out property <string> student_id;
    in-out property <string> student_name;
    in-out property <string> faculty;

    in-out property <bool> course1_accept_button_pressed: false;
    in-out property <bool> course2_accept_button_pressed: false;
    in-out property <bool> course3_accept_button_pressed: false;
    in-out property <bool> course4_accept_button_pressed: false;
    in-out property <bool> course5_accept_button_pressed: false;

    in-out property <bool> course1_decline_button_pressed: false;
    in-out property <bool> course2_decline_button_pressed: false;
    in-out property <bool> course3_decline_button_pressed: false;
    in-out property <bool> course4_decline_button_pressed: false;
    in-out property <bool> course5_decline_button_pressed: false;

    // Course request fields per slot (split per line for readability)
    in-out property <string> c1_code;
    in-out property <string> c1_name;
    in-out property <string> c1_l_day;
    in-out property <string> c1_l_slot;
    in-out property <string> c1_t_day;
    in-out property <string> c1_t_slot;

    in-out property <string> c2_code;
    in-out property <string> c2_name;
    in-out property <string> c2_l_day;
    in-out property <string> c2_l_slot;
    in-out property <string> c2_t_day;
    in-out property <string> c2_t_slot;

    in-out property <string> c3_code;
    in-out property <string> c3_name;
    in-out property <string> c3_l_day;
    in-out property <string> c3_l_slot;
    in-out property <string> c3_t_day;
    in-out property <string> c3_t_slot;

    in-out property <string> c4_code;
    in-out property <string> c4_name;
    in-out property <string> c4_l_day;
    in-out property <string> c4_l_slot;
    in-out property <string> c4_t_day;
    in-out property <string> c4_t_slot;

    in-out property <string> c5_code;
    in-out property <string> c5_name;
    in-out property <string> c5_l_day;
    in-out property <string> c5_l_slot;
    in-out property <string> c5_t_day;
    in-out property <string> c5_t_slot;

    in-out property <bool> Submit_Button_Pressed: false;
    in-out property <bool> show_warning: false;
    in-out property <bool> no_course_requests: false;
    in-out property <bool> is_next_student_available: false;
    in-out property <bool> is_previous_student_available;

    // ==========================================
    // Action Triggers (Callbacks)
    // These send a signal to the C++ code to perform a task when a user interacts with the screen
    // ==========================================

    // General user actions
    callback check_credentials(string, string, int);
    callback change_picture();
    callback logout();

    // Student actions
    callback request_course(string, string, string, string, string);
    callback submit_withdrawal_req(string, string);
    callback submit_excuse_req(string, string, string);

    // Teacher actions
    callback load_students(string, int);
    callback save_attendance([StudentAttendanceData], string, int);
    callback load_grades(string);
    callback save_grades([StudentGradeData], string);

    // Admin actions
    callback admin_end_semester() -> string;
    callback admin_handle_withdrawal(string, string, bool);
    callback admin_handle_excuse(string, string, string, bool);
    callback admin_next_student();
    callback admin_previous_student();
    callback admin_submit_decisions();
    callback admin_check_teacher_email(string) -> string;
    callback admin_check_assign_course(string) -> string;
    callback admin_assign_course_submit(string, string, string, string, string, string);
    callback admin_validate_assign_schedule(string, string, string, string, string, string) -> string;
    callback admin_add_student_submit(string, string, string);
    callback admin_add_teacher_submit(string, string, string);

    // ==========================================
    // Visual Display Routing
    // This section loads the correct screen based on the active_panel number
    // ==========================================

    Rectangle {

        // Show the Login Screen if the panel is set to 0
        if (active_panel == 0) : Login_Page {
            width: 100%;
            height: 100%;
            ui-scale: root.global_scale;

            // Link the error messages to the shared variables
            Error_State <=> root.login_error_state;
            Error_Message <=> root.login_error_msg;

            // Trigger the C++ login check when the user tries to log in
            login_attempted(email, pass, type) => { root.check_credentials(email, pass, type); }
        }

        // Show the Student Dashboard if the panel is set to 1
        if (active_panel == 1) : Student_Profile {
            width: 100%;
            height: 100%;
            ui-scale: root.global_scale;

            // Link the visual profile text to the stored data
            user_name: root.user_name;
            user_id: root.user_id;
            user_email: root.user_email;
            user_Faculty: root.user_Faculty;
            user_profile_pic: root.user_profile_pic;
            student_gpa: root.student_gpa;

            // Link the tables for the student's courses and schedule
            my_courses <=> root.my_courses;
            available_courses <=> root.available_courses;
            requested_courses <=> root.requested_courses;
            request_submitted <=> root.request_submitted;
            status_message <=> root.status_message;
            Logout_value <=> root.Logout_value;
            active_tab <=> root.student_active_tab;
            student_schedule_data <=> root.student_schedule_data;
            registered_course_codes <=> root.my_course_codes;

            // Link the data for the student's past history
            passed_courses : root.passed_courses;
            failed_courses : root.failed_courses;
            enrollment_name: root.enrollment_name;
            enrollment_id: root.enrollment_id;
            enrollment_gpa: root.enrollment_gpa;

            // Connect the buttons to their respective actions
            Logout => { root.logout(); }
            change_picture => { root.change_picture(); }
            request_course(code, ld, ls, td, ts) => { root.request_course(code, ld, ls, td, ts); }
            submit_withdrawal_req(code, reason) => { root.submit_withdrawal_req(code, reason); }
            submit_excuse_req(code, week, reason) => { root.submit_excuse_req(code, week, reason); }
        }

        // Show the Teacher Dashboard if the panel is set to 2
        if (active_panel == 2) : Teacher_Profile {
            width: 100%;
            height: 100%;
            ui-scale: root.global_scale;

            // Link the teacher's profile text and picture
            user_name: root.user_name;
            user_email: root.user_email;
            user_profile_pic: root.user_profile_pic;
            Logout_value <=> root.Logout_value;

            // Link the teacher's classes, attendance sheets, and grades
            teacher_display_list <=> root.teacher_profile_display_list;
            available_courses <=> root.available_courses;
            students_data <=> root.students_data;
            grades_data <=> root.grades_data;
            teacher_schedule_data <=> root.teacher_schedule_data;

            // Connect the buttons to their respective actions
            Logout => { root.logout(); }
            change_picture => { root.change_picture(); }
            load_students(course, week) => { root.load_students(course, week); }
            save_attendance(data, course, week) => { root.save_attendance(data, course, week); }
            load_grades(course) => { root.load_grades(course); }
            save_grades(data, course) => { root.save_grades(data, course); }
        }

        // Show the Administrator Dashboard if the panel is set to 3
        if (active_panel == 3) : Admin_Profile {
            width: 100%;
            height: 100%;
            ui-scale: root.global_scale;

            // Link the admin's profile text and active tabs
            User_name: root.user_name;
            User_email: root.user_email;
            User_profile_pic: root.user_profile_pic;
            admin_position: root.admin_position;
            active_tab <=> root.admin_active_tab;

            // Link the lists of pending student requests
            pending_withdrawals <=> root.pending_withdrawals;
            pending_excuses <=> root.pending_excuses;

            // Link the massive list of variables used to review and approve student course requests
            student_id <=> root.student_id;
            student_name <=> root.student_name;
            faculty <=> root.faculty;
            Submit_Button_Pressed <=> root.Submit_Button_Pressed;
            show_warning <=> root.show_warning;
            no_course_requests <=> root.no_course_requests;
            is_next_student_available <=> root.is_next_student_available;
            is_previous_student_available <=> root.is_previous_student_available;

            course1_accept_button_pressed <=> root.course1_accept_button_pressed;
            course2_accept_button_pressed <=> root.course2_accept_button_pressed;
            course3_accept_button_pressed <=> root.course3_accept_button_pressed;
            course4_accept_button_pressed <=> root.course4_accept_button_pressed;
            course5_accept_button_pressed <=> root.course5_accept_button_pressed;

            course1_decline_button_pressed <=> root.course1_decline_button_pressed;
            course2_decline_button_pressed <=> root.course2_decline_button_pressed;
            course3_decline_button_pressed <=> root.course3_decline_button_pressed;
            course4_decline_button_pressed <=> root.course4_decline_button_pressed;
            course5_decline_button_pressed <=> root.course5_decline_button_pressed;

            // Bind each course-request field explicitly for maintainability
            c1_code <=> root.c1_code;
            c1_name <=> root.c1_name;
            c1_l_day <=> root.c1_l_day;
            c1_l_slot <=> root.c1_l_slot;
            c1_t_day <=> root.c1_t_day;
            c1_t_slot <=> root.c1_t_slot;

            c2_code <=> root.c2_code;
            c2_name <=> root.c2_name;
            c2_l_day <=> root.c2_l_day;
            c2_l_slot <=> root.c2_l_slot;
            c2_t_day <=> root.c2_t_day;
            c2_t_slot <=> root.c2_t_slot;

            c3_code <=> root.c3_code;
            c3_name <=> root.c3_name;
            c3_l_day <=> root.c3_l_day;
            c3_l_slot <=> root.c3_l_slot;
            c3_t_day <=> root.c3_t_day;
            c3_t_slot <=> root.c3_t_slot;

            c4_code <=> root.c4_code;
            c4_name <=> root.c4_name;
            c4_l_day <=> root.c4_l_day;
            c4_l_slot <=> root.c4_l_slot;
            c4_t_day <=> root.c4_t_day;
            c4_t_slot <=> root.c4_t_slot;

            c5_code <=> root.c5_code;
            c5_name <=> root.c5_name;
            c5_l_day <=> root.c5_l_day;
            c5_l_slot <=> root.c5_l_slot;
            c5_t_day <=> root.c5_t_day;
            c5_t_slot <=> root.c5_t_slot;

            // Link the status messages for adding users and assigning courses
            assign_course_status_message: root.assign_course_status_message;
            add_student_status_message: root.add_student_status_message;
            next_student_id: root.next_student_id;
            add_teacher_status_message: root.add_teacher_status_message;

            // Connect the buttons to their respective actions
            Logout => { root.logout(); }
            change_picture => { root.change_picture(); }
            admin_handle_withdrawal(id, course, approved) => { root.admin_handle_withdrawal(id, course, approved); }
            admin_handle_excuse(id, course, week, approved) => { root.admin_handle_excuse(id, course, week, approved); }
            admin_end_semester => { return root.admin_end_semester(); }
            admin_next_student => { root.admin_next_student(); }
            admin_previous_student => { root.admin_previous_student(); }
            admin_submit_decisions => { root.admin_submit_decisions(); }
            check_teacher_email(email) => { return root.admin_check_teacher_email(email); }
            check_assign_course(code) => { return root.admin_check_assign_course(code); }
            assign_course_submit(email, code, l1, l2, t1, t2) => { root.admin_assign_course_submit(email, code, l1, l2, t1, t2); }
            validate_assign_schedule(email, code, l1, l2, t1, t2) => { return root.admin_validate_assign_schedule(email, code, l1, l2, t1, t2); }
            add_student_submit(name, fac, pass) => { root.admin_add_student_submit(name, fac, pass); }
            add_teacher_submit(fn, ln, pass) => { root.admin_add_teacher_submit(fn, ln, pass); }
        }
    }
}