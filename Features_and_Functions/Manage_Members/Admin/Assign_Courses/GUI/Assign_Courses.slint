import { Button, LineEdit } from "std-widgets.slint";

export component AssignCoursesWindow inherits Rectangle {

    // =========================
    // Properties
    // =========================

    in-out property <string> teacher_email: "";
    in-out property <string> course_name: "";

    // =========================
    // Callbacks
    // =========================

    callback assign_clicked(string, string);
    callback close_clicked();

    // =========================
    // Window Style
    // =========================

    width: 400px;
    height: 350px;

    background: #f8f9fa;

    border-radius: 12px;
    border-width: 2px;
    border-color: #007bff;

    // =========================
    // Layout
    // =========================

    VerticalLayout {

        padding: 25px;
        spacing: 15px;

        Text {
            text: "Assign Course";
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            color: #007bff;
        }

        // =========================
        // Input Fields
        // =========================

        LineEdit {
            placeholder-text: "Teacher Email";
            text <=> root.teacher_email;
        }

        LineEdit {
            placeholder-text: "Course Name";
            text <=> root.course_name;
        }

        Rectangle {
            height: 15px;
            background: transparent;
        }

        // =========================
        // Buttons
        // =========================

        HorizontalLayout {

            spacing: 10px;

            Button {

                text: "Assign Course";
                primary: true;

                clicked => {

                    root.assign_clicked(
                        root.teacher_email,
                        root.course_name
                    );
                }
            }

            Button {

                text: "Cancel";

                clicked => {
                    root.close_clicked();
                }
            }
        }
    }
}