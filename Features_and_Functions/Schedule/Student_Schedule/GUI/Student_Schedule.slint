export struct CourseSlot {
    course_name: string,
    course_code: string,
    slot_type: string,
    day_index: int,
    start_hour: float,
    duration_hours: float,
    bg_color: color,
}

export component Student_Schedule inherits Rectangle {
    in property <[CourseSlot]> schedule_slots;
    in property <float> ui-scale: 1.0;

    property <int> start-hour: 9;
    property <int> end-hour: 16;
    property <[string]> days: ["Sun", "Mon", "Tue", "Wed", "Thu"];

    width: 95%;
    height: 95%;

    // Dynamic metrics
    property <length> side-header-width: 80px * root.ui-scale;
    property <length> header-height: 50px * root.ui-scale;
    property <length> hour-col-width: (self.width - side-header-width) / (end-hour - start-hour);
    property <length> day-row-height: (self.height - header-height) / days.length;

    // Base container
    background: #ffffff;
    border-color: #d0d2d6;
    border-width: 2px * root.ui-scale;
    border-radius: 8px * root.ui-scale;
    clip: true; // Keeps everything neatly inside the rounded corners

    // --- BACKGROUND PANELS ---
    // Top Header Row Background
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: header-height;
        background: #f8f9fa;
    }
    // Left Column Background
    Rectangle {
        x: 0; y: 0;
        width: side-header-width;
        height: parent.height;
        background: #f8f9fa;
    }

    // --- EXPLICIT GRID LINES ---
    // Vertical Lines
    for hour[i] in (end-hour - start-hour): Rectangle {
        x: side-header-width + i * hour-col-width;
        y: 0;
        width: 1px * root.ui-scale;
        height: parent.height;
        background: #e0e0e0;
    }
    // Horizontal Lines
    for day[i] in days: Rectangle {
        x: 0;
        y: header-height + i * day-row-height;
        width: parent.width;
        height: 1px * root.ui-scale;
        background: #e0e0e0;
    }

    // --- HEADERS ---
    // Time Text
    for hour[i] in (end-hour - start-hour): Text {
        x: side-header-width + i * hour-col-width;
        y: 0;
        width: hour-col-width;
        height: header-height;
        text: (start-hour + i < 10 ? "0" : "") + (start-hour + i) + ":00 - " +
              (start-hour + i + 1 < 10 ? "0" : "") + (start-hour + i + 1) + ":00";
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 600;
        color: #727275;
        font-size: max(9px, min(hour-col-width * 0.11, header-height * 0.35));
    }

    // Day Text
    for day[i] in days: Text {
        x: 0;
        y: header-height + i * day-row-height;
        width: side-header-width;
        height: day-row-height;
        text: day;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 700;
        color: #727275;
        font-size: max(10px, min(side-header-width * 0.2, day-row-height * 0.25));
    }

    // --- COURSE BLOCKS ---
    for slot in schedule_slots: Rectangle {
        x: side-header-width + (slot.start_hour - start-hour) * hour-col-width;
        y: header-height + slot.day_index * day-row-height;
        width: slot.duration_hours * hour-col-width;
        height: day-row-height;

        Rectangle {
            width: parent.width - 8px * root.ui-scale;
            height: parent.height - 8px * root.ui-scale;
            x: 4px * root.ui-scale;
            y: 4px * root.ui-scale;
            background: slot.bg_color;
            border-radius: 8px * root.ui-scale;
            border-color: slot.bg_color.darker(0.1);
            border-width: 1px * root.ui-scale;
            clip: true;

            VerticalLayout {
                padding: 4px * root.ui-scale;
                alignment: center;
                Text {
                    text: slot.course_code;
                    font-weight: 700;
                    color: slot.bg_color.darker(0.8);
                    font-size: max(10px, min(hour-col-width * 0.12, day-row-height * 0.25));
                    horizontal-alignment: center;
                }
                Text {
                    text: slot.slot_type;
                    color: slot.bg_color.darker(0.7);
                    font-size: max(9px, min(hour-col-width * 0.09, day-row-height * 0.18));
                    font-italic: true;
                    horizontal-alignment: center;
                }
            }
        }
    }
}