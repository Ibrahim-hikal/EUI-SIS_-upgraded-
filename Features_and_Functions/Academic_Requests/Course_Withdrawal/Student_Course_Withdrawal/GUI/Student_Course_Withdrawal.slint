import { CustomDropdown } from "../../../../Shared_GUI/Custom_dropdown.slint";

export component Student_Course_Withdrawal inherits Rectangle {
    in property <float> ui-scale: 1.0;
    in property <[string]> registered_course_codes;
    callback submit_withdrawal(string, string);

    width: 500px * root.ui-scale;
    background: #F2F2F2;
    border-radius: 15px * root.ui-scale;
    clip: false;

    VerticalLayout {
        padding: 30px * root.ui-scale;
        spacing: 20px * root.ui-scale;

        Text { text: "Course Withdrawal"; font-size: 24px * root.ui-scale; font-weight: 800; color: black; horizontal-alignment: center; }

        // --- ROW 1: HIGHEST Z-INDEX ---
        Rectangle {
            z: 100;
            height: 75px * root.ui-scale;
            clip: false;
            VerticalLayout {
                spacing: 8px * root.ui-scale;
                Text { text: "Select Registered Course:"; font-size: 16px * root.ui-scale; color: black; font-weight: 600; }
                course_drop := CustomDropdown {
                    ui-scale: root.ui-scale;
                    model: root.registered_course_codes;
                }
            }
        }

        // --- ROW 2: LOWER Z-INDEX ---
        Rectangle {
            z: 50;
            height: 75px * root.ui-scale;
            VerticalLayout {
                spacing: 8px * root.ui-scale;
                Text { text: "Reason:"; font-size: 16px * root.ui-scale; color: black; font-weight: 600; }
                Rectangle {
                    height: 45px * root.ui-scale; background: #e8e8e8; border-radius: 5px * root.ui-scale; border-width: 1px; border-color: #64647a;
                    reason_input := TextInput { width: 95%; height: 100%; color: black; vertical-alignment: center; font-size: 16px * root.ui-scale; }
                    if (reason_input.text == "") : Text { text: "Enter reason..."; color: #727275; vertical-alignment: center; x: 10px * root.ui-scale; }
                }
            }
        }

        // --- ROW 3: LOWEST Z-INDEX ---
        Rectangle {
            z: 10;
            height: 50px * root.ui-scale; border-radius: 8px * root.ui-scale;
            background: btn_touch.pressed ? #0056b3 : #4A4A4A;
            Text { text: "Submit Request"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            btn_touch := TouchArea {
                clicked => {
                    if (course_drop.current_value != "Select...") {
                        root.submit_withdrawal(course_drop.current_value, reason_input.text);
                        reason_input.text = "";
                    }
                }
            }
        }
    }
}